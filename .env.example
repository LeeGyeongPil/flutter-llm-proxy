# Server-side environment for `flutter_llm_proxy serve` (real mode only).
# `demo` and `serve --mock` need none of these.
# Keys stay on the server; never put them in the Flutter app.

# Provider keys (variable names can be changed with key_env in proxy.yaml)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Listen port (Cloud Run sets this for you); --port overrides it
PORT=8080

# CLI and log language: en or ko (--lang overrides it)
FLUTTER_LLM_PROXY_LANG=
